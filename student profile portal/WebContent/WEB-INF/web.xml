<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Student Profile Portal</display-name>
    <description>
        Web Technology Lab Assignment 3:
        Student profile viewer with JDBC MySQL connectivity, dynamic image &amp; document streaming,
        looping and conditional JSP logic, and session-based authentication security.
    </description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlets Configuration -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.student.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.student.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentListServlet</servlet-name>
        <servlet-class>com.student.servlet.StudentListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentListServlet</servlet-name>
        <url-pattern>/students</url-pattern>
        <url-pattern>/StudentPortal</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ImageStreamServlet</servlet-name>
        <servlet-class>com.student.servlet.ImageStreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ImageStreamServlet</servlet-name>
        <url-pattern>/stream-image</url-pattern>
        <url-pattern>/ImageStreamServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DocumentStreamServlet</servlet-name>
        <servlet-class>com.student.servlet.DocumentStreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentStreamServlet</servlet-name>
        <url-pattern>/stream-document</url-pattern>
        <url-pattern>/DocumentStreamServlet</url-pattern>
    </servlet-mapping>

    <!-- Security Filter Configuration -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.student.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Session Configuration: 30 minutes inactivity timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>
